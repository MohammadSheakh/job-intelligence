# Copy this file to .env, then supply secret-bearing values locally or through your host.
# Never commit real database, OAuth, SMTP, AI, or session credentials.

DATABASE_URL=
# Normally set by Docker Compose: local or neon.
DATABASE_MODE=unknown

# Core behavior
AI_ENABLED=false
AI_DAILY_LIMIT=0
EMAIL_ENABLED=false
DEFAULT_MATCH_THRESHOLD=70
CRAWL_LIMIT=
CRAWL_DELAY_MS=750

# Optional AI enhancement
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=
AI_API_KEY=

# SMTP email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Admin UI
ADMIN_HOST=127.0.0.1
ADMIN_PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Candidate portal
DEFAULT_CANDIDATE_PASSWORD=asdfasdf
CANDIDATE_SESSION_SECRET=
CANDIDATE_SESSION_DAYS=30
PUBLIC_BASE_URL=http://127.0.0.1:3000
COOKIE_SECURE=false

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Candidate quick search
QUICK_SEARCH_DELAY_MS=350

# Redis sliding window rate limiting
REDIS_URL=redis://127.0.0.1:6379
RATE_LIMIT_FAIL_OPEN=true

# Optional Cloudflare Tunnel for secure remote access
CLOUDFLARE_TUNNEL_TOKEN=
