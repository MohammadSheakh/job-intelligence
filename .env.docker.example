# Docker runtime overrides.
# Local mode ignores DATABASE_URL and uses the bundled PostgreSQL service.
# Neon mode uses DATABASE_URL from .env. See docs/DATABASE_SWITCHING.md.

APP_PORT=3000
LOCAL_DB_PASSWORD=jobapp_local

# Local admin login. Change these if the stack is reachable by other people.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=asdfasdf

# Candidate accounts created by admin receive this password initially and must change it.
DEFAULT_CANDIDATE_PASSWORD=asdfasdf

# Replace for anything beyond private localhost development.
CANDIDATE_SESSION_SECRET=local-development-session-secret-2026-change-before-production
PUBLIC_BASE_URL=http://localhost:3000
COOKIE_SECURE=false

# Daily scheduler, Asia/Dhaka time.
DAILY_CRAWL_HOUR=6
DAILY_CRAWL_MINUTE=15
RUN_DAILY_ON_START=false

# Optional integrations.
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=
AI_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
