{
  "name": "job-intelligence-frontend",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "format": "pnpm --dir .. exec prettier --write frontend",
    "format:check": "pnpm --dir .. exec prettier --check frontend",
    "lint": "pnpm --dir .. exec eslint frontend --max-warnings 0",
    "lint:fix": "pnpm --dir .. exec eslint frontend --fix --max-warnings 0"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "next": "^15.5.2",
    "postcss": "^8.5.28",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2"
  }
}
