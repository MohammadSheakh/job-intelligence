{
  "name": "job-intelligence-backend",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "prisma:schema:build": "node prisma/scripts/build-prisma-schema.mjs",
    "prisma:generate": "pnpm prisma:schema:build && prisma generate",
    "prisma:db:pull": "prisma db pull --print"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^24.5.2",
    "@types/express": "^5.0.3",
    "@types/pg": "^8.15.5",
    "prisma": "^7.10.0",
    "typescript": "^5.9.2"
  }
}
