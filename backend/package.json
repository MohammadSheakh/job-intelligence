{
  "name": "job-intelligence-backend",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "prisma:schema:build": "node prisma/scripts/build-prisma-schemaV2.js",
    "prisma:generate": "pnpm prisma generate --schema prisma/schema.prisma",
    "prisma:db:pull": "prisma db pull --print",
    "test": "jest --runInBand",
    "test:unit": "jest --config jest.config.cjs --testMatch '**/src/**/*.spec.ts'",
    "test:integration": "jest --config jest.config.cjs --testMatch '**/test/integration/**/*.integration-spec.ts'",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test:database": "node test/scripts/run-database-tests.mjs",
    "test:e2e": "node test/scripts/run-database-tests.mjs --e2e",
    "format": "pnpm --dir .. exec prettier --write backend",
    "format:check": "pnpm --dir .. exec prettier --check backend",
    "lint": "pnpm --dir .. exec eslint backend --max-warnings 0",
    "lint:fix": "pnpm --dir .. exec eslint backend --fix --max-warnings 0",
    "test:browser": "node test/scripts/run-database-tests.mjs --browser",
    "prisma:sync": "pnpm run prisma:schema:build && pnpm run prisma:generate",
    "prisma:seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "prisma:migrate:dev": "node prisma/scripts/migrate-dev.mjs",
    "prisma:migrate:status": "pnpm prisma migrate status --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "pnpm run prisma:migrations:check && pnpm prisma migrate deploy --schema prisma/schema.prisma",
    "crawl:daily": "node dist/src/commands/crawl-daily.js",
    "notify:daily": "node dist/src/commands/notify-daily.js",
    "prisma:migrations:check": "node prisma/scripts/check-migrations.mjs",
    "typecheck:prisma": "tsc -p tsconfig.prisma.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cheerio": "1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "csv-parse": "6.1.0",
    "domhandler": "5.0.3",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "ioredis": "^6.0.0",
    "ipaddr.js": "2.2.0",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.3",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^6.4.19",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "playwright": "^1.63.0",
    "prisma": "^7.10.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "^5.9.2"
  }
}
