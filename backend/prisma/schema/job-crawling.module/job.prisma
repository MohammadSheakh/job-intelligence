model Job {
  id              BigInt         @id @default(autoincrement())
  companyId       String         @map("company_id")
  title           String
  description     String?
  location        String?
  work_mode       String?
  skills          String?
  experience      String?
  application_url String?
  application_deadline DateTime? @db.Timestamptz(6)
  published_at    DateTime?      @db.Timestamptz(6)
  first_seen_at   DateTime       @default(now()) @db.Timestamptz(6)
  last_seen_at    DateTime       @default(now()) @db.Timestamptz(6)
  status          String         @default("OPEN")
  jobHash         String         @unique @map("job_hash")
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  notifications   Notification[]
  categories      JobCategory[]

  @@index([companyId])
  @@index([status])
  @@map("jobs")
}

model JobCategory {
  jobId      BigInt   @map("job_id")
  categoryId BigInt   @map("category_id")
  source     String   @default("inferred")
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([jobId, categoryId])
  @@index([categoryId])
  @@index([jobId])
  @@map("job_categories")
}

model CrawlLog {
  id           BigInt   @id @default(autoincrement())
  company_id   String?
  checked_at   DateTime @default(now()) @db.Timestamptz(6)
  success      Boolean
  jobs_found   Int      @default(0)
  http_status  Int?
  duration_ms  Int?
  crawler_type String?
  jobs_created Int?
  jobs_updated Int?
  action_taken String?
  error        String?
  companies    Company? @relation(fields: [company_id], references: [id], onUpdate: NoAction)

  @@map("crawl_logs")
}
