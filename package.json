{
  "name": "job-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate": "tsx scripts/migrate.ts",
    "db:import-companies": "tsx scripts/import-companies.ts",
    "db:verify": "tsx scripts/verify.ts",
    "crawl:pilot": "tsx scripts/crawl-pilot.ts",
    "typecheck": "tsc --noEmit",
    "crawl:daily": "tsx scripts/crawl-daily.ts",
    "crawl:dry": "tsx scripts/crawl-dry-run.ts",
    "candidate:add": "tsx scripts/add-candidate.ts",
    "match:preview": "tsx scripts/match-preview.ts",
    "notify:daily": "tsx scripts/notify-daily.ts",
    "settings:set": "tsx scripts/set-setting.ts",
    "admin": "tsx src/admin/server.ts",
    "categories:enrich": "tsx scripts/enrich-categories.ts",
    "db:migrate:portal": "tsx scripts/migrate-portal.ts",
    "candidate:set-default-password": "tsx scripts/set-default-password.ts",
    "env:check": "tsx scripts/check-env.ts",
    "build": "tsc",
    "start": "node dist/src/admin/server.js",
    "dev:backend": "pnpm --dir backend dev",
    "dev:frontend": "pnpm --dir frontend dev",
    "build:backend": "pnpm --dir backend build",
    "build:frontend": "pnpm --dir frontend build",
    "start:backend": "pnpm --dir backend start",
    "start:frontend": "pnpm --dir frontend start",
    "test:backend": "pnpm --dir backend test",
    "test:unit": "pnpm --dir backend test:unit",
    "test:integration": "pnpm --dir backend test:integration",
    "test:database": "pnpm --dir backend test:database",
    "test:e2e": "pnpm --dir backend test:e2e",
    "test:browser": "pnpm --dir backend test:browser",
    "prisma:migrate:dev": "pnpm --dir backend prisma:migrate:dev",
    "prisma:migrate:deploy": "pnpm --dir backend prisma:migrate:deploy",
    "prisma:migrate:status": "pnpm --dir backend prisma:migrate:status",
    "prisma:sync": "pnpm --dir backend prisma:sync",
    "prisma:seed": "pnpm --dir backend prisma:seed",
    "docker:bootstrap": "tsx scripts/docker-bootstrap.ts",
    "docker:scheduler": "tsx scripts/docker-scheduler.ts",
    "db:status": "tsx scripts/db-status.ts",
    "prd:audit": "tsx scripts/prd-audit.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "check:style": "pnpm format:check && pnpm lint",
    "check:agents": "node .agents/scripts/check-instructions.mjs"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.2",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@next/eslint-plugin-next": "15.5.25",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^6.4.19",
    "@types/pg": "^8.15.5",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-plugin-react-hooks": "^5",
    "globals": "^16",
    "prettier": "^3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8"
  }
}
